# --- Server ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Database (create it first; see README) ---
DATABASE_URL=postgres://ardb:CHANGE_ME@localhost:5432/tnsc_ardb_hrms

# --- Auth (TNCU parity: HS256, 60 min access, rotating refresh) ---
JWT_SECRET=replace-with-64-random-chars
JWT_ISSUER=TNSC.ARDB.HRMS
JWT_AUDIENCE=TNSC.ARDB.HRMS.Client
JWT_ACCESS_MINUTES=60
REFRESH_TOKEN_DAYS=7
CAPTCHA_ENABLED=true

# --- Modules: comma list. Add "epf" once the EPF Trust module is implemented. ---
MODULES_ENABLED=hr,payroll

# --- Files (photos, documents) — outside any web root ---
FILE_STORAGE_ROOT=./storage
